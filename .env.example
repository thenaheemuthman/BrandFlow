# GEMINI_API_KEY: Required for Gemini AI API calls in server-side AI phases.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional in Phase 1; enables PostgreSQL persistence)
# In production, use Supabase Auth + RLS. The public key is safe in the browser; never add a service-role key to frontend variables.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
