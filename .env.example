# GEMINI_API_KEY: Required for Gemini AI API calls in server-side AI phases.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional in Phase 1; enables PostgreSQL persistence)
# When omitted, BrandFlow AI stores data in local server storage (.data/brandflow-db.json).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
